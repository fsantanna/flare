+// Bench: what changed in an entity since the last frame
+struct BenchSeen {
+	int state;
+	float hp;
+};
+
+static std::map<int, BenchSeen>& benchSeen() {
+	static std::map<int, BenchSeen> m;
+	return m;
+}
+
+static void benchEntity(StatBlock* st) {
+	int id = bench::id(st, st->hero);
+	std::map<int, BenchSeen>::iterator it = benchSeen().find(id);
+	if (it == benchSeen().end()) {
+		BENCH_T("spawn %d %s %d %.9g %.9g %.9g", id, st->name.c_str(), st->cur_state, st->pos.x, st->pos.y, st->hp);
+	}
+	else {
+		if (it->second.state != st->cur_state)
+			BENCH_T("state %d %d %.9g %.9g", id, st->cur_state, st->pos.x, st->pos.y);
+		// a loss of hp (regeneration is in the dump of the hero)
+		if (st->hp < it->second.hp)
+			BENCH_T("hit %d %.9g", id, st->hp);
+	}
+	BenchSeen s;
+	s.state = st->cur_state;
+	s.hp = st->hp;
+	benchSeen()[id] = s;
+}
+
+static void benchTrace() {
+	if (!bench::trace()) return;
+	static int epoch = -1;
+	if (epoch != bench::epoch()) {
+		epoch = bench::epoch();
+		benchSeen().clear();
+	}
+	benchEntity(&pc->stats);
+	for (size_t i = 0; i < entitym->entities.size(); ++i)
+		benchEntity(&entitym->entities[i]->stats);
+	if (bench::dump())
+		BENCH_T("hero %.9g %.9g %d %.9g %d", pc->stats.pos.x, pc->stats.pos.y, pc->stats.cur_state, pc->stats.hp, pc->stats.direction);
+}
