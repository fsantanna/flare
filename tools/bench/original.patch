+// Bench: scripted input, pushed as SDL events before the input is handled
+static void benchInput() {
+	static FILE* f = NULL;
+	static bool init = false;
+	static unsigned long next = 0;
+	static char line[256];
+	static bool pending = false;
+	static int mx = 0, my = 0;
+	if (!init) {
+		init = true;
+		const char* e = bench::env("FLARE_INPUT");
+		if (e) f = fopen(e, "r");
+	}
+	if (!f) return;
+	while (true) {
+		if (!pending) {
+			if (!fgets(line, sizeof(line), f)) { fclose(f); f = NULL; return; }
+			if (line[0] == '#' || line[0] == '\n') continue;
+			next = strtoul(line, NULL, 10);
+			pending = true;
+		}
+		if (next > bench::frame()) return;
+		pending = false;
+		char cmd[32] = "", arg[64] = "";
+		int a = 0, b = 0;
+		if (sscanf(line, "%*u %31s %63s %d", cmd, arg, &b) < 1) continue;
+		a = atoi(arg);
+		SDL_Event ev;
+		memset(&ev, 0, sizeof(ev));
+		if (strcmp(cmd, "move") == 0) {
+			mx = a; my = b;
+			ev.type = SDL_MOUSEMOTION;
+			ev.motion.x = mx; ev.motion.y = my;
+		}
+		else if (strcmp(cmd, "down") == 0 || strcmp(cmd, "up") == 0) {
+			ev.type = (cmd[0] == 'd') ? SDL_MOUSEBUTTONDOWN : SDL_MOUSEBUTTONUP;
+			ev.button.button = static_cast<Uint8>(a);
+			ev.button.state = (cmd[0] == 'd') ? SDL_PRESSED : SDL_RELEASED;
+			ev.button.x = mx; ev.button.y = my;
+		}
+		else if (strcmp(cmd, "key") == 0 || strcmp(cmd, "keyup") == 0) {
+			ev.type = (strcmp(cmd, "key") == 0) ? SDL_KEYDOWN : SDL_KEYUP;
+			ev.key.keysym.scancode = SDL_GetScancodeFromName(arg);
+			ev.key.keysym.sym = SDL_GetKeyFromScancode(ev.key.keysym.scancode);
+			ev.key.state = (ev.type == SDL_KEYDOWN) ? SDL_PRESSED : SDL_RELEASED;
+		}
+		else if (strcmp(cmd, "quit") == 0) {
+			ev.type = SDL_QUIT;
+		}
+		else {
+			continue;
+		}
+		SDL_PushEvent(&ev);
+	}
+}
+
+// Bench: each file of the list FLARE_INI, as FileParser reads it across
+// the mods, to the trace: "file <path>", then "[<section>]" when a new
+// section starts, then "<key>=<value>"
+static void benchIni() {
+	FILE* list = fopen(bench::env("FLARE_INI"), "r");
+	FILE* out = bench::trace();
+	if (!list || !out) return;
+	char line[1024];
+	while (fgets(line, sizeof(line), list)) {
+		std::string path = Parse::trim(line);
+		if (path.empty()) continue;
+		fprintf(out, "file %s\n", path.c_str());
+		FileParser fp;
+		if (!fp.open(path, FileParser::MOD_FILE, FileParser::ERROR_NONE)) {
+			fprintf(out, "none\n");
+			continue;
+		}
+		while (fp.next()) {
+			if (fp.new_section)
+				fprintf(out, "[%s]\n", fp.section.c_str());
+			fprintf(out, "%s=%s\n", fp.key.c_str(), fp.val.c_str());
+		}
+		fp.close();
+	}
+	fclose(list);
+	fflush(out);
+}
+
+// Bench: each animation file of the list FLARE_ANIM, as AnimationSet
+// loads it, to the trace
+static void benchAnim() {
+	FILE* list = fopen(bench::env("FLARE_ANIM"), "r");
+	FILE* out = bench::trace();
+	if (!list || !out) return;
+	char line[1024];
