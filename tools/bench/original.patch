+/*
+Bench: a fixed seed, scripted input, a trace, and a fast mode, for the
+comparison of Flare with its port to Atmos (fsantanna/flare).
+
+It is included before every source file (-include Bench.h), and all is
+driven by environment variables:
+
+	FLARE_SEED=<n>        seed of the generator that replaces rand()
+	FLARE_FAST=1          no frame cap: one logic frame per loop
+	FLARE_FRAMES=<n>      exit after n logic frames
+	FLARE_INPUT=<file>    scripted input, by logic frame
+	FLARE_TRACE=<file>    the trace ("-" for stdout)
+	FLARE_DUMP=1          trace the hero in every frame
+	FLARE_NEWGAME=<class> skip the title: a new game of this class index
+	FLARE_MAP=<file>      the first map of the new game
+	FLARE_SHOT=<n>:<file> save the screen at logic frame n (BMP)
+
+The generator is a 64-bit LCG whose upper 31 bits are the result, from
+0 to RAND_MAX (2^31-1 in glibc), as rand() of the C library.
+*/
+
+#ifndef BENCH_H
+#define BENCH_H
+
+#include <algorithm>
+#include <climits>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <ctime>
+#include <fstream>
+#include <iostream>
+#include <list>
+#include <map>
+#include <queue>
+#include <set>
+#include <sstream>
+#include <stdint.h>
+#include <string>
+#include <vector>
+
+namespace bench {
+
+inline const char* env(const char* name) {
+	const char* v = getenv(name);
+	return (v && *v) ? v : NULL;
+}
+
+inline uint64_t& state() {
+	static uint64_t s = 0;
+	return s;
+}
+
+inline int rnd() {
+	uint64_t& s = state();
+	s = s * 6364136223846793005ULL + 1442695040888963407ULL;
+	return static_cast<int>(s >> 33);
+}
+
+inline void seed(unsigned int x) {
+	const char* e = env("FLARE_SEED");
+	state() = e ? strtoull(e, NULL, 10) : x;
+}
+
+inline unsigned long& frame() {
+	static unsigned long f = 0;
+	return f;
+}
+
+inline FILE* trace() {
+	static FILE* f = NULL;
+	static bool init = false;
+	if (!init) {
+		init = true;
+		const char* e = env("FLARE_TRACE");
+		if (e) f = (strcmp(e, "-") == 0) ? stdout : fopen(e, "w");
+	}
+	return f;
+}
+
+inline bool fast() {
+	return env("FLARE_FAST") != NULL;
+}
+
+inline unsigned long frames() {
+	const char* e = env("FLARE_FRAMES");
+	return e ? strtoul(e, NULL, 10) : 0;
+}
+
+inline bool dump() {
+	return env("FLARE_DUMP") != NULL;
+}
+
+// the logic frame of FLARE_SHOT, or -1
+inline long shotFrame() {
+	const char* e = env("FLARE_SHOT");
+	return e ? strtol(e, NULL, 10) : -1;
+}
+
+inline const char* shotFile() {
+	const char* e = env("FLARE_SHOT");
+	if (!e) return NULL;
+	const char* c = strchr(e, ':');
+	return c ? c + 1 : NULL;
+}
+
+// ids of entities in the trace: the hero is 0, the others are numbered
+// from 1 in the order they are first seen; reset at each map
+inline std::map<const void*, int>& ids() {
+	static std::map<const void*, int> m;
+	return m;
+}
+
+inline int& nextId() {
+	static int n = 1;
+	return n;
+}
+
+inline int id(const void* p, bool hero) {
+	if (hero) return 0;
+	std::map<const void*, int>::iterator it = ids().find(p);
+	if (it != ids().end()) return it->second;
+	int n = nextId()++;
+	ids()[p] = n;
+	return n;
+}
+
+// the number of maps loaded
+inline int& epoch() {
+	static int n = 0;
+	return n;
+}
+
+inline void resetIds() {
+	ids().clear();
+	nextId() = 1;
+	epoch()++;
+}
+
+} // namespace bench
+
+// one line of the trace: the logic frame, then the fields
+#define BENCH_T(...) do { \
+	FILE* bench_f_ = bench::trace(); \
+	if (bench_f_) { \
+		fprintf(bench_f_, "%lu ", bench::frame()); \
+		fprintf(bench_f_, __VA_ARGS__); \
+		fputc('\n', bench_f_); \
+		fflush(bench_f_); \
+	} \
+} while (0)
+
+#define rand() bench::rnd()
+#define srand(x) bench::seed(x)
+
+#endif
