+// Bench: one logic frame, then the frame count and the end of the run
+static bool benchLogic() {
+	SDL_PumpEvents();
+	benchInput();
+	inpt->handle();
+	gswitch->logic();
+	inpt->resetScroll();
+	bench::frame()++;
+	unsigned long n = bench::frames();
+	return gswitch->done || inpt->done || (n > 0 && bench::frame() >= n);
+}
+
+// Bench: no frame cap, one logic frame and one render per loop
+static void benchLoop() {
+	bool done = false;
+	while (!done) {
+		if (!gswitch->isLoadingFrame())
+			done = benchLogic();
+		render_device->blankScreen();
+		gswitch->render();
+		render_device->commitFrame();
+	}
+}
