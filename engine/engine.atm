;; The engine of the port, over `engine/flare.h`: the functions of C as a
;; table `fl`, and the clock of logic frames.
;;
;; The program runs inside the loop of `flare.h`, which emits, once per
;; logic frame, the input of the frame, then `:frame [n]`, then `:draw`
;; (see the header of `engine/flare.h`).

```:prelude
#include "engine/flare.h"
```

;; the actions of the input, as `Input::` of the original
val Input = [
    CANCEL = 0, ACCEPT = 1, UP = 2, DOWN = 3, LEFT = 4, RIGHT = 5,
    BAR_1 = 6, BAR_2 = 7, BAR_3 = 8, BAR_4 = 9, BAR_5 = 10, BAR_6 = 11, BAR_7 = 12,
    BAR_8 = 13, BAR_9 = 14, BAR_0 = 15,
    CHARACTER = 16, INVENTORY = 17, POWERS = 18, LOG = 19, MAIN1 = 20, MAIN2 = 21,
    AIM_UP = 32, AIM_DOWN = 33, AIM_LEFT = 34, AIM_RIGHT = 35,
    CTRL = 40, SHIFT = 41, ALT = 42,
]

;; the movement and collide types of MapCollision
val MOVE = [NORMAL = 0, FLYING = 1, INTANGIBLE = 2]
val COLLIDE = [NONE = 0, ALL = 1, HERO = 2, HAZARD = 3]

val fl = [
    ;; the size of the render
    W = `:number FL_W`,
    H = `:number FL_H`,

    ;; the logic frames done, and the frames per second of the original
    frame = func () {
        `:number FL_FRAME`
    },
    FPS = 60,

    ;; the generator of the patched original: from 0 to 2^31-1
    rand = func () {
        `:number fl_rand()`
    },

    ;; the names of the files of a directory with an extension, in the
    ;; order of readdir, or nil
    dir = func (path, ext) {
        `:value fl_dir(fl_cstr($path), fl_cstr($ext))`
    },

    ;; the calls to fl.rand since the last time
    rand_calls = func () {
        val n = `:number FL_RND_CALLS`
        `FL_RND_CALLS = 0;`
        n
    },

    ;; a line of the trace, after the logic frame
    trace = func (s) {
        `fl_trace(fl_cstr($s));`
    },
    tracing = func () {
        `:boolean (FL_TRACE != NULL)`
    },

    ;; images: an index, or -1
    img = func (path) {
        `:number fl_img_load(fl_cstr($path))`
    },
    size = func (i) {
        val w = `:number ({ FlImg* p = fl_img(fl_int($i)); p ? p->w : 0; })`
        val h = `:number ({ FlImg* p = fl_img(fl_int($i)); p ? p->h : 0; })`
        return w, h
    },
    ;; fl.draw(img, x, y): the whole image
    draw = func (i, x, y) {
        `fl_img_draw(fl_int($i), 0,0,0,0, fl_int($x),fl_int($y), 255, 0xFFFFFF, 0);`
    },
    ;; fl.part(img, sx,sy,sw,sh, x,y [,alpha [,color [,blend]]])
    part = func (i, sx, sy, sw, sh, x, y, a, c, b) {
        val alpha = if a == nil => 255 => a
        val color = if c == nil => 0xFFFFFF => c
        val blend = if b == nil => 0 => b
        `fl_img_draw(fl_int($i), fl_int($sx),fl_int($sy),fl_int($sw),fl_int($sh), fl_int($x),fl_int($y), fl_int($alpha), fl_int($color), fl_int($blend));`
    },
    ;; fl.fill(0xRRGGBBAA, x,y,w,h)
    fill = func (c, x, y, w, h) {
        `fl_fill((int64_t)a_dbl($c), fl_int($x),fl_int($y),fl_int($w),fl_int($h));`
    },

    ;; fonts: an index, or -1; style: 1 bold, 2 italic, 4 underline
    font = func (path, size, style) {
        val st = style || 0
        `:number fl_font_load(fl_cstr($path), fl_int($size), fl_int($st))`
    },
    ;; fl.text(font, s, x, y [,color [,justify [,blend]]]): justify 0 left,
    ;; 1 right, 2 center
    text = func (f, s, x, y, color, justify, blend) {
        val c = if color == nil => 0xFFFFFF => color
        val j = justify || 0
        val b = if blend == false => 0 => 1
        `fl_font_draw(fl_int($f), fl_cstr($s), fl_int($x), fl_int($y), fl_int($j), fl_int($c), fl_int($b));`
    },
    text_width = func (f, s) {
        `:number fl_font_width(fl_int($f), fl_cstr($s))`
    },
    text_height = func (f) {
        `:number fl_font_height(fl_int($f))`
    },

    ;; sounds: an index, or -1 (also with no audio)
    snd = func (path) {
        `:number fl_snd_load(fl_cstr($path))`
    },
    play = func (i, vol) {
        val v = if vol == nil => 128 => vol
        `fl_snd_play(fl_int($i), fl_int($v));`
    },
    music = func (path) {
        `fl_music(fl_cstr($path));`
    },
    music_stop = func () {
        `fl_music_stop();`
    },

    ;; the map: see `engine/map.h`
    tset_reset = func () {
        `fl_tset_reset();`
    },
    tset_tile = func (i, img, x, y, w, h, ox, oy) {
        `fl_tset_tile(fl_int($i), fl_int($img), fl_int($x), fl_int($y), fl_int($w), fl_int($h), fl_int($ox), fl_int($oy));`
    },
    tset_anim = func (i, x, y, dur) {
        `fl_tset_anim(fl_int($i), fl_int($x), fl_int($y), fl_int($dur));`
    },
    tset_done = func () {
        `fl_tset_done();`
    },
    tset_logic = func () {
        `fl_tset_logic();`
    },
    map_new = func (w, h) {
        `fl_map_new(fl_int($w), fl_int($h));`
    },
    map_layer = func (name) {
        `:number fl_map_layer(fl_cstr($name))`
    },
    map_row = func (l, y, s) {
        `:boolean fl_map_row(fl_int($l), fl_int($y), fl_cstr($s))`
    },
    map_done = func (bg) {
        `FL_BG = (int64_t)a_dbl($bg);`
        `fl_map_done();`
    },
    map_render = func () {
        `fl_map_render();`
    },
    ;; the camera: positions are 32-bit floats
    cam_warp = func (x, y) {
        `fl_cam_warp((float)a_dbl($x), (float)a_dbl($y));`
    },
    cam_target = func (x, y) {
        `fl_cam_target((float)a_dbl($x), (float)a_dbl($y));`
    },
    cam_logic = func () {
        `fl_cam_logic();`
    },
    cam = func () {
        return `:number.float (double)FL_CAM.x`, `:number.float (double)FL_CAM.y`
    },
    ;; objects to draw in this frame: fl.ren(dead, img, sx,sy,sw,sh, ox,oy, mx,my, prio, hero, alpha, color, blend)
    ren_clear = func () {
        `fl_ren_clear();`
    },
    ren = func (dead, img, sx, sy, sw, sh, ox, oy, mx, my, prio, hero, alpha, color, blend) {
        val d = if dead => 1 => 0
        val h = if hero => 1 => 0
        val a = alpha || 255
        val c = color || 0xFFFFFF
        val b = blend || 0
        `fl_ren_push(fl_int($d), fl_int($img), fl_int($sx), fl_int($sy), fl_int($sw), fl_int($sh), fl_int($ox), fl_int($oy), (float)a_dbl($mx), (float)a_dbl($my), fl_int($prio), fl_int($h), fl_int($a), fl_int($c), fl_int($b));`
    },

    ;; input: the actions of `Input` (pressing, lock), and the mouse
    pressing = func (k) {
        `:boolean FL_PRESSING[fl_int($k)]`
    },
    locked = func (k) {
        `:boolean FL_LOCK[fl_int($k)]`
    },
    lock = func (k, v) {
        val b = if v => 1 => 0
        `FL_LOCK[fl_int($k)] = fl_int($b);`
    },
    ;; pressing and not locked
    pressed = func (k) {
        `:boolean (FL_PRESSING[fl_int($k)] && !FL_LOCK[fl_int($k)])`
    },
    mouse = func () {
        return `:number FL_MOUSE_X`, `:number FL_MOUSE_Y`
    },

    ;; collision: see `engine/collision.h`
    col_block = func (x, y, ally) {
        val a = if ally => 1 => 0
        `fl_col_block((float)a_dbl($x), (float)a_dbl($y), fl_int($a));`
    },
    col_unblock = func (x, y) {
        `fl_col_unblock((float)a_dbl($x), (float)a_dbl($y));`
    },
    col_valid = func (x, y, mt, ct) {
        `:boolean fl_col_valid((float)a_dbl($x), (float)a_dbl($y), fl_int($mt), fl_int($ct))`
    },
    col_sight = func (x1, y1, x2, y2) {
        `:boolean fl_col_sight((float)a_dbl($x1), (float)a_dbl($y1), (float)a_dbl($x2), (float)a_dbl($y2))`
    },
    ;; fl.move(x, y, dir, speed, effect_speed, mt, hero): ok, x, y
    move = func (x, y, dir, speed, eff, mt, hero) {
        val h = if hero => 1 => 0
        val ok = `:boolean fl_entity_move((float)a_dbl($x), (float)a_dbl($y), fl_int($dir), (float)a_dbl($speed), (float)a_dbl($eff), fl_int($mt), fl_int($h))`
        return ok, `:number.float (double)FL_MOVE_X`, `:number.float (double)FL_MOVE_Y`
    },
    ;; screen to map, at the camera (as Utils::screenToMap)
    scr2map = func (x, y) {
        val p = `:number.float (double)fl_scr2map(fl_int($x), fl_int($y), FL_CAM.x, FL_CAM.y).x`
        val q = `:number.float (double)fl_scr2map(fl_int($x), fl_int($y), FL_CAM.x, FL_CAM.y).y`
        return p, q
    },

    ;; geometry with 32-bit floats: see `engine/geom.h`
    direction = func (x0, y0, x1, y1) {
        `:number fl_direction((float)a_dbl($x0), (float)a_dbl($y0), (float)a_dbl($x1), (float)a_dbl($y1))`
    },
    dist = func (x1, y1, x2, y2) {
        `:number.float (double)fl_distf((float)a_dbl($x1), (float)a_dbl($y1), (float)a_dbl($x2), (float)a_dbl($y2))`
    },
    vector = func (x, y, dir, d) {
        val px = `:number.float (double)fl_vector((float)a_dbl($x), (float)a_dbl($y), fl_int($dir), (float)a_dbl($d)).x`
        val py = `:number.float (double)fl_vector((float)a_dbl($x), (float)a_dbl($y), fl_int($dir), (float)a_dbl($d)).y`
        return px, py
    },
    rotate = func (dir, v) {
        `:number fl_rotate(fl_int($dir), fl_int($v))`
    },
    face_next = func (dir, x, y, mx, my) {
        `:number fl_face_next(fl_int($dir), (float)a_dbl($x), (float)a_dbl($y), (float)a_dbl($mx), (float)a_dbl($my))`
    },

    ;; the path from one point to another (MapCollision::computePath): its
    ;; points from the end to the start, or an empty vector
    path = func (sx, sy, ex, ey, mt) {
        `fl_path((float)a_dbl($sx), (float)a_dbl($sy), (float)a_dbl($ex), (float)a_dbl($ey), fl_int($mt), 0);`
        val n = `:number FL_PATH_N`
        val ret = []
        loop i in n {
            set ret@+ = [`:number.float (double)FL_PATH[(int)a_dbl($i)].x`, `:number.float (double)FL_PATH[(int)a_dbl($i)].y`]
        }
        ret
    },
    line_move = func (x1, y1, x2, y2, mt) {
        `:boolean fl_col_line_move((float)a_dbl($x1), (float)a_dbl($y1), (float)a_dbl($x2), (float)a_dbl($y2), fl_int($mt))`
    },

    ;; f32(x): x rounded to 32 bits, as a `float` of the original
    f32 = func (x) {
        `:number.float (double)(float)a_dbl($x)`
    },
]

;; awaits n logic frames
task Frames (n) {
    loop _ in n {
        await :frame
    }
}
