;; The game screen: GameStatePlay of the original. Its task `Play` runs the
;; logic frames in the order of `GameStatePlay::logic`, and prints the
;; trace of the patched original (`doc/fidelity.md`).
;;
;; The frame, in order:
;;      the hero                    pc->logic()
;;      a hidden draw               EntityManager::handleSpawn: Map_Enemy()
;;      the map, when it changes    checkTeleport()
;;      the tiles, the camera       mapr->logic()
;;      the trace                   benchTrace()

val play = [
    world = nil,        ;; the world of the current map (see play_world)
    events = [],        ;; the events of the current map
    seen = nil,         ;; what the trace saw in the last frame: the hero
    seen_es = [],       ;; and the enemies, by id
]

func play.f (x) {
    string.format("%.9g", x)
}

;; the trace of the end of a frame, as benchTrace of the patch
func play.trace (h, es) {
    if fl.tracing() {
        val s = play.seen
        ifs {
            s == nil => {
                fl.trace("spawn 0 " ++ h.name ++ " " ++ h.state ++ " " ++ play.f(h.x) ++ " " ++ play.f(h.y) ++ " " ++ play.f(h.hp))
            }
            else => {
                if s.state != h.state {
                    fl.trace("state 0 " ++ h.state ++ " " ++ play.f(h.x) ++ " " ++ play.f(h.y))
                }
                if h.hp < s.hp {
                    fl.trace("hit 0 " ++ play.f(h.hp))
                }
            }
        }
        set play.seen = [state = h.state, hp = h.hp]
        ;; the enemies, in order, as the entities of EntityManager
        loop i, e in es {
            val id = i + 1
            val p = e.pub
            val s2 = play.seen_es@id
            if s2 == nil {
                fl.trace("spawn " ++ id ++ " " ++ p.name ++ " " ++ p.state ++ " " ++ play.f(p.x) ++ " " ++ play.f(p.y) ++ " " ++ play.f(p.hp))
            } else {
                if s2.state != p.state {
                    fl.trace("state " ++ id ++ " " ++ p.state ++ " " ++ play.f(p.x) ++ " " ++ play.f(p.y))
                }
                if p.hp < s2.hp {
                    fl.trace("hit " ++ id ++ " " ++ play.f(p.hp))
                }
            }
            set play.seen_es@id = [state = p.state, hp = p.hp]
        }
        if os.getenv("FLARE_DUMP") {
            fl.trace("hero " ++ play.f(h.x) ++ " " ++ play.f(h.y) ++ " " ++ h.state ++ " " ++ play.f(h.hp) ++ " " ++ h.dir)
        }
    }
    if os.getenv("FLARE_RNG") {
        val n = fl.rand_calls()
        if n > 0 {
            fl.trace("rng " ++ n)
        }
    }
}

;; the screen rectangle of an enemy at the camera (Entity::getRenderBounds)
func play.bounds (e) {
    val cx, cy = fl.cam()
    val sx, sy = fl.map2scr(e.x, e.y, cx, cy)
    val g = anim.gfx(e.cur.a, e.cur.sub, e.dir)
    if g => [sx - g@5, sy - g@6, g@3, g@4] => [0, 0, 0, 0]
}

;; GameStatePlay::checkEnemyFocus, with the mouse: the enemy of the last
;; hit of a hazard, or the alive enemy under the mouse nearest to its center
func play.focus (h, ens) {
    var enemy = nil
    if combat.last_enemy {
        set enemy = combat.last_enemy
        set combat.last_enemy = nil
    } else {
        val mx, my = fl.mouse()
        var best = nil
        loop _, t in ens {
            val e = t.pub
            if (e.state != STATE.DEAD) && (e.state != STATE.CRITDEAD) {
                val r = play.bounds(e)
                if (mx >= r@0) && (my >= r@1) && (mx < (r@0 + r@2)) && (my < (r@1 + r@3)) {
                    val d = fl.dist(mx, my, fl.f32(r@0 + (r@2 / 2)), fl.f32(r@1 + (r@3 / 2)))
                    if (best == nil) || (d < best) {
                        set best = d
                        set enemy = e
                    }
                }
            }
        }
    }
    set h.cursor_enemy = enemy
}

;; MenuActionBar::checkAction, for the main buttons of the mouse: the power
;; of the slot, aimed at the mouse (aim_assist of misc.txt: 96)
func play.actions (h) {
    loop _, i in [10, 11] {
        val k = if i == 10 => Input.MAIN1 => Input.MAIN2
        if fl.pressed(k) {
            val id = hero.actionbar@i || 0
            val pw = power.get(id)
            ;; the slot is disabled while the power is cast
            val enabled = (h.casting@id == nil) || timer_end(h.casting@id)
            if pw && enabled && (pw.requires_mp <= h.mp) {
                val mx, my = fl.mouse()
                val tx, ty = fl.scr2map(mx, if pw.aim_assist => (my + 96) => my)
                if timer_end(h.cooldown) && (h.state != STATE.POWER) && (h.state != STATE.HIT) {
                    set h.actions@+ = [power = id, target = [tx, ty]]
                }
            }
        }
    }
}

;; the hidden draws of a map loaded (EntityManager::handleNewMap): a
;; Map_Enemy, and getRandomNeighbor of the tiles around the hero
func play.new_map_draws (x, y, skip) {
    if !skip {
        fl.rand()
    }
    var n = 0
    loop i in (-1, 1) {
        loop j in (-1, 1) {
            if (i != 0) || (j != 0) {
                if fl.col_valid(math.floor(x) + i + 0.5, math.floor(y) + j + 0.5, MOVE.NORMAL, COLLIDE.ALL) {
                    set n += 1
                }
            }
        }
    }
    if n > 0 {
        fl.rand()
    }
}

;; A new game in a map, at a position (or at the hero of the map).
;; MapRenderer::checkEvents at the hero, from the frame of the hero
func play_check_events (h) {
    if play.world {
        event.check(play.events, h.x, h.y, play.world)
    }
}

;; The world of a map: what its events and its entities request in a frame
func play_world (h) {
    [hero = h, teleport = nil, spawns = [], powers = [], delayed = [],
     skip_delay = false, cleared = false]
}

;; EntityManager::handleSpawn: the entities requested in this frame, in
;; state SPAWN (with the draw of the enemy of their category)
func play_spawns (w, es, ens) {
    loop _, sp in w.spawns {
        fl.col_unblock(sp.x, sp.y)
        val el = enemy_random(sp.type, 0, 0)
        if el {
            val t = spawn @es Enemy(enemy.stats(el.type),
                [type = el.type, x = sp.x, y = sp.y, dir = sp.dir, wander = 0, waypoints = [], state = "spawn"])
            set t.pub.id = #ens + 1
            set ens@+ = t
            fl.col_block(sp.x, sp.y, false)
        }
    }
    set w.spawns = []
}

;; A map, from its load (in the checkTeleport of a frame) to the frame in
;; which a teleport to another map is requested. It ends with that request.
task MapRun (path, pos, h) {
    val hp = h.pub
    fl.trace("map " ++ path)
    val m = map.load(path)
    val p = pos || m.hero
    set hp.x, hp.y = fl.f32(p@0), fl.f32(p@1)
    set hp.camera_lock = true
    fl.cam_warp(hp.x, hp.y)
    ;; MapRenderer::load: the groups of enemies
    val placed = enemy.place(enemy.groups(m))
    ;; the events, then those on load
    val w = play_world(hp)
    set play.world = w
    set play.events = event.load(m)
    event.on_load(play.events, w)
    ;; EntityManager::handleNewMap: its Map_Enemy, the enemies, the neighbor
    fl.rand()
    pin es = tasks()
    pin ens = []                ;; the enemies in order, as EntityManager
    loop _, me in placed {
        val t = spawn @es Enemy(enemy.stats(me.type), me)
        set t.pub.id = #ens + 1
        set ens@+ = t
        fl.col_block(me.x, me.y, false)
    }
    play.new_map_draws(p@0, p@1, true)
    set combat.list = []
    set play.seen = nil
    set play.seen_es = []
    fl.col_block(hp.x, hp.y, false)

    ;; the rest of the frame of the load
    event.logic(play.events, w)
    fl.tset_logic()
    fl.cam_logic()
    play.trace(hp, ens)

    loop on :frame {
        play.focus(hp, ens)
        play.actions(hp)
        emit @h :hero.logic
        fl.rand()                       ;; handleSpawn: Map_Enemy()
        play_spawns(w, es, ens)
        loop _, t in ens {
            emit @t :enemy.logic [hero = hp]
        }
        hazards_logic(ens, hp)
        loot.logic(hp)
        ;; checkTeleport: another map ends this one
        if w.teleport {
            val tp = w.teleport
            set w.teleport = nil
            if tp.map {
                break tp
            }
            set hp.x, hp.y = fl.f32(tp.pos@0), fl.f32(tp.pos@1)
        }
        set w.cleared = true
        loop _, t in ens {
            if t.pub.hp > 0 {
                set w.cleared = false
            }
        }
        event.logic(play.events, w)
        fl.tset_logic()
        fl.cam_logic()
        play.trace(hp, ens)
    }
}

;; A new game in a map, at a position (or at the hero of the map), then the
;; maps it teleports to.
task Play (path, pos, class) {
    val st = hero.stats(class)
    hero.load_sfx("male")
    hero.load_steps(st.sfx_step)

    ;; GameStatePlay(): the hidden draw of its handleNewMap
    fl.rand()

    ;; frame 0: the hidden draw of the frame, then the map
    await :frame
    fl.rand()
    pin h = spawn Hero(st, pos || [0, 0])

    spawn {
        var next = [map = path, pos = pos]
        loop {
            set next = await MapRun(next.map, next.pos, h)
        }
    }

    loop on :draw {
        fl.ren_clear()
        val hp = h.pub
        val g = anim.gfx(hp.cur.a, hp.cur.sub, hp.dir)
        if g {
            fl.ren(false, g@0, g@1, g@2, g@3, g@4, g@5, g@6, hp.x, hp.y, 0, true)
        }
        fl.map_render()
    }
}
