;; The enemies: Entity and EntityBehavior of the original.
;;
;; One task per enemy, `Enemy`, awakened by the game once per logic frame
;; with `:enemy.logic`, in the order of the entities. Each frame it does
;; what EntityBehavior::logic does: the upkeep of its stats, finding its
;; target, choosing a power, moving; and then, in place of the `switch` of
;; `updateState`, it emits `:enemy.step` to its current action, a task
;; that ends with the next action:
;;
;;      cur_state = ENTITY_STANCE / MOVE    EStance(), EMove()
;;      cur_state = ENTITY_POWER            EPower(ai_power)
;;      cur_state = ENTITY_HIT              EHit()
;;      cur_state = ENTITY_DEAD             EDead()
;;
;; What the enemy perceives of the fight (in combat, line of sight, the
;; target and its distance) and its timers are fields of `pub`, as stats
;; of the original, since the order of their tests in a frame is that of
;; the original, and the draws of the generator follow it.

;; a Timer of the original: [cur, dur]
func timer (d) {
    [cur = 0, dur = d]
}
func timer_set (t, d) {
    set t.cur = d
    set t.dur = d
}
func timer_tick (t) {
    if t.cur > 0 {
        set t.cur = t.cur - 1
    }
}
func timer_end (t) {
    t.cur == 0
}
func timer_begin (t) {
    set t.cur = t.dur
}

;; a timer of the stats of an enemy: full if its file set it (setDuration),
;; empty otherwise (the constructor of Timer)
func timer_of (st, k, d) {
    val t = timer(d)
    if st.set_by_file@k {
        set t.cur = d
    }
    t
}

;; the encounter distance of the settings (Settings::updateScreenVars)
val ENCOUNTER_DIST = `:number.float (double)(sqrtf(powf((float)(FL_W/192), 2.f) + powf((float)(FL_H/48), 2.f)) / 2.f)`

;; StatBlock::getAIPower: the powers of a type that pass their chance and
;; cooldown, then one of them
func ai_power (e, type) {
    val ok = []
    loop _, p in e.powers {
        if p.type == type {
            if percent_f(p.chance) && timer_end(p.cd) {
                set ok@+ = p
            }
        }
    }
    if #ok == 0 => nil => ok@(fl.rand() % #ok)
}

;; EntityBehavior::getWanderPoint
func ai_wander_point (e) {
    val x = e.wander_area@0 + (fl.rand() % e.wander_area@2) + 0.5
    val y = e.wander_area@1 + (fl.rand() % e.wander_area@2) + 0.5
    if fl.col_valid(x, y, e.movement, COLLIDE.ALL) && fl.line_move(e.x, e.y, x, y, e.movement) {
        [x, y]
    } else {
        [e.x, e.y]
    }
}

;; Entity::move for an enemy
func ai_move (e) {
    if e.speed == 0 {
        false
    } else {
        val ok, x, y = fl.move(e.x, e.y, e.dir, e.speed, 100, e.movement, false)
        set e.x = x
        set e.y = y
        ok
    }
}

;; Entity::setAnimation
func ai_anim (e, name) {
    if e.cur.a.name != name {
        set e.cur = anim.cursor(anim.get(e.anims, name))
    }
}

;; EntityBehavior::findTarget, with the hero as the only target (no allies)
func ai_find_target (e, hero_st) {
    if (e.state == STATE.DEAD) || (e.state == STATE.CRITDEAD) {
        return nil
    }
    ;; the hero, if alive
    if hero_st.hp > 0 {
        set e.target_dist = fl.dist(e.x, e.y, hero_st.x, hero_st.y)
    } else {
        set e.target_dist = 0
    }
    set e.hero_dist = e.target_dist
    if (e.speed == 0) && (e.combat_style == "disabled") {
        set e.target_dist = 0
        set e.hero_dist = 0
        set e.in_combat = false
    }
    if (e.target_dist < e.threat_range) && (hero_st.hp > 0) {
        set e.los = fl.col_sight(e.x, e.y, hero_st.x, hero_st.y)
    } else {
        set e.los = false
    }
    if e.los {
        timer_begin(e.cooldown_los)
    }
    if !e.in_combat && (e.combat_style == "aggressive") {
        set e.join_combat = true
    }
    ;; the stealth of the hero is 0 here
    val close = e.target_dist < e.threat_range
    if (e.hp > 0) && !e.in_combat && e.los && close && (e.combat_style != "passive") && (e.combat_style != "disabled") {
        set e.join_combat = true
    }
    if e.join_combat {
        set e.in_combat = true
        timer_begin(e.cooldown_los)
        val b = ai_power(e, "beacon")
        if b {
            power_activate(b.id, e, e.x, e.y)
        }
        val j = ai_power(e, "on_join_combat")
        if j {
            set e.next = [act = "power", power = j]
        }
        set e.join_combat = false
    } else {
        if e.combat_style != "aggressive" {
            if e.target_dist > e.threat_range_far {
                set e.in_combat = false
            }
            if (e.cooldown_los.dur > 0) && timer_end(e.cooldown_los) {
                set e.in_combat = false
            }
        }
    }
    if (e.hp <= 0) || (hero_st.hp <= 0) {
        set e.in_combat = false
    }
    set e.pursue = [hero_st.x, hero_st.y]
    if e.wander && (#e.waypoints == 0) {
        set e.waypoints@+ = ai_wander_point(e)
        timer_begin(e.waypoint_timer)
    }
    if !(e.in_combat || (#e.waypoints == 0)) {
        set e.pursue = e.waypoints@0
    }
    if e.in_combat && (e.state == STATE.STANCE) && !e.move_to_safe_dist && (e.target_dist < e.flee_range) &&
            (e.target_dist >= e.melee_range) && percent_f(e.chance_flee) && timer_end(e.flee_cooldown) {
        set e.move_to_safe_dist = true
    }
    if e.move_to_safe_dist {
        set e.fleeing = true
    }
    if e.fleeing {
        val middle = fl.direction(e.pursue@0, e.pursue@1, e.x, e.y)
        val dirs = []
        loop k in (-2, 2) {
            val d = fl.rotate(middle, k)
            val tx, ty = fl.vector(e.x, e.y, d, 1)
            if fl.col_valid(tx, ty, e.movement, COLLIDE.ALL) {
                if d == e.dir {
                    set dirs@0 = d
                    loop {
                        while #dirs > 1
                        vector.remove(dirs)
                    }
                    break
                } else {
                    set dirs@+ = d
                }
            }
        }
        if #dirs == 0 {
            set e.move_to_safe_dist = false
            set e.fleeing = false
        } else {
            val i = rand_between(0, #dirs - 1)
            val px, py = fl.vector(e.x, e.y, dirs@i, 1)
            set e.pursue = [px, py]
            if timer_end(e.flee_timer) {
                timer_begin(e.flee_timer)
            }
        }
    }
}

;; EntityBehavior::checkPower
func ai_check_power (e) {
    if e.fleeing || !e.in_combat || !timer_end(e.cooldown) {
        return nil
    }
    if (e.state == STATE.STANCE) || (e.state == STATE.MOVE) {
        val p = if e.target_dist > e.melee_range => ai_power(e, "ranged") => ai_power(e, "melee")
        if p {
            val pw = power.get(p.id)
            if pw && !(!e.los && (pw.requires_los || pw.requires_los_default)) {
                set e.next = [act = "power", power = p]
                set e.state = STATE.POWER
                if pw.new_state != "instant" {
                    set e.cur = anim.cursor(e.cur.a)      ;; resetActiveAnimation
                }
            }
        }
    }
}

;; EntityBehavior::checkMoveStateStance
func ai_move_stance (e) {
    if (e.target_dist >= e.flee_range) && (e.chance_flee > 0) && (#e.waypoints == 0) {
        return nil
    }
    val should = (e.in_combat || (#e.waypoints > 0)) &&
        (((e.target_dist > e.melee_range) && percent_f(e.chance_pursue)) || ((e.target_dist <= e.melee_range) && !e.los))
    if should || e.fleeing {
        if ai_move(e) {
            set e.state = STATE.MOVE
        } else {
            set e.collided = true
            val prev = e.dir
            set e.dir = fl.face_next(e.dir, e.x, e.y, e.pursue@0, e.pursue@1)
            if ai_move(e) {
                set e.state = STATE.MOVE
            } else {
                set e.dir = prev
            }
        }
    }
}

;; EntityBehavior::checkMoveStateMove
func ai_move_move (e, hero_st) {
    var can_attack = false
    if timer_end(e.cooldown) {
        loop _, p in e.powers {
            if timer_end(p.cd) {
                set can_attack = true
                break
            }
        }
    }
    val stop_fleeing = can_attack && e.fleeing && timer_end(e.flee_timer) && !percent_f(e.chance_flee)
    if !stop_fleeing && timer_end(e.flee_timer) {
        set e.flee_timer.cur = math.min(1, e.flee_timer.dur)
    }
    if (hero_st.hp > 0) && (((e.target_dist < e.melee_range) && !e.fleeing && e.in_combat && e.los) ||
            (e.move_to_safe_dist && (e.target_dist >= e.flee_range)) || stop_fleeing) {
        if stop_fleeing {
            timer_begin(e.flee_cooldown)
        }
        set e.state = STATE.STANCE
        set e.move_to_safe_dist = false
        set e.fleeing = false
    } else {
        if !ai_move(e) {
            set e.collided = true
            val prev = e.dir
            set e.dir = fl.face_next(e.dir, e.x, e.y, e.pursue@0, e.pursue@1)
            if !ai_move(e) {
                set e.state = STATE.STANCE
                set e.dir = prev
            }
        }
    }
}

;; EntityBehavior::checkMove
func ai_check_move (e, hero_st) {
    if (e.state == STATE.DEAD) || (e.state == STATE.CRITDEAD) {
        return nil
    }
    if !e.in_combat && ((#e.waypoints == 0) || !timer_end(e.waypoint_timer)) {
        if e.state == STATE.MOVE {
            set e.state = STATE.STANCE
        }
        return nil
    }
    val real_speed = fl.real_speed(e.speed, e.dir, 100)
    val ticks = e.turn_timer.cur
    timer_set(e.turn_timer, e.turn_delay)
    val max_ticks = if real_speed == 0 => e.turn_delay => math.floor(fl.f32(1 / real_speed))
    if e.turn_delay > max_ticks {
        timer_set(e.turn_timer, max_ticks)
    }
    set e.turn_timer.cur = math.min(ticks, e.turn_timer.dur)
    fl.col_unblock(e.x, e.y)
    timer_tick(e.path_fail_timer)
    if e.facing {
        timer_tick(e.turn_timer)
        if timer_end(e.turn_timer) {
            if !fl.line_move(e.x, e.y, e.pursue@0, e.pursue@1, e.movement) {
                var recalc = false
                set e.chance_path = e.chance_path + 5
                val success = (fl.rand() % 100) < e.chance_path
                if success {
                    set recalc = true
                }
                if e.collided {
                    set recalc = true
                }
                if !recalc && (#e.path == 0) {
                    set recalc = true
                }
                if !recalc && (fl.dist(math.floor(e.prev_target@0), math.floor(e.prev_target@1),
                                       math.floor(e.pursue@0), math.floor(e.pursue@1)) > 1) {
                    set recalc = true
                }
                if !e.path_found && e.collided && !success {
                    set recalc = false
                } else {
                    set e.collided = false
                }
                if !timer_end(e.path_fail_timer) {
                    set recalc = false
                    set e.chance_path = -100
                }
                set e.prev_target = e.pursue
                if recalc {
                    set e.chance_path = -100
                    set e.path = fl.path(e.x, e.y, e.pursue@0, e.pursue@1, e.movement)
                    set e.path_found = #e.path > 0
                    if !e.path_found {
                        set e.path_fails = e.path_fails + 1
                        if e.path_fails >= 3 {
                            timer_begin(e.path_fail_timer)
                        }
                    } else {
                        set e.path_fails = 0
                        set e.path_fail_timer.cur = 0
                    }
                }
                if #e.path > 0 {
                    set e.pursue = e.path@#
                    if fl.dist(e.x, e.y, e.pursue@0, e.pursue@1) <= 1 {
                        vector.remove(e.path)
                    }
                }
            } else {
                set e.path = []
            }
            set e.dir = fl.direction(e.x, e.y, e.pursue@0, e.pursue@1)
            timer_begin(e.turn_timer)
        }
    }
    timer_tick(e.flee_timer)
    timer_tick(e.flee_cooldown)
    if e.state == STATE.STANCE {
        ai_move_stance(e)
    } else {
        if e.state == STATE.MOVE {
            ai_move_move(e, hero_st)
        }
    }
    if #e.waypoints > 0 {
        val w = e.waypoints@0
        val wd = fl.dist(w@0, w@1, e.x, e.y)
        val sx, sy = e.x, e.y
        ai_move(e)
        val nd = fl.dist(w@0, w@1, e.x, e.y)
        set e.x, e.y = sx, sy
        if (wd <= real_speed) || ((wd <= 0.5) && (nd > wd)) {
            set e.x, e.y = fl.f32(w@0), fl.f32(w@1)
            set e.turn_timer.cur = 0
            vector.remove(e.waypoints, 0)
            val nw = if e.wander => ai_wander_point(e) => w
            set e.waypoints@+ = nw
            timer_begin(e.waypoint_timer)
        }
    }
    fl.col_block(e.x, e.y, false)
}

;; StatBlock::logic for an enemy: its timers and the regeneration of hp
func ai_stats_logic (e, hero_st) {
    timer_tick(e.cooldown_hit)
    timer_tick(e.state_timer)
    timer_tick(e.waypoint_timer)
    timer_tick(e.cooldown)
    timer_tick(e.cooldown_los)
    loop _, p in e.powers {
        timer_tick(p.cd)
    }
    if (e.hp <= e.hp_max) && (e.hp > 0) {
        var regen = 0.0
        if !e.in_combat && (hero_st.hp > 0) {
            ;; resting_hp_regen_seconds of 5
            set regen = fl.f32(fl.f32(e.hp_max / fl.f32(5.0)) / 60)
        } else {
            set regen = fl.f32(fl.f32((e.base.hp_regen || 0) / fl.f32(60.0)) / 60)
        }
        set e.hp = math.max(0.0, math.min(fl.f32(e.hp + regen), e.hp_max))
    }
    effect.damage(e)
}

;; ENTITY_STANCE and ENTITY_MOVE of updateState: the animation of the
;; state the decisions of the frame left
task EStance (e) {
    loop {
        await :enemy.step
        ;; a decision of this frame: the next action takes this step
        until e.next, e.next
        if e.state == STATE.MOVE {
            ai_anim(e, "run")
        } else {
            ai_anim(e, "stance")
        }
    }
}

;; ENTITY_POWER: the animation of the power, the power at its active frame,
;; and the stance at its last frame, after which the cooldown begins. It
;; starts in the step of the decision.
task EPower (e, p) {
    set e.state = STATE.POWER
    val pw = power.get(p.id)
    loop {
        if pw.new_state == "attack" {
            ai_anim(e, pw.attack_anim)
        }
        if anim.is_first(e.cur) {
            ;; the sound of the attack (Entity::playAttackSound)
            loop _, sa in e.sfx_attack {
                if sa@0 == pw.attack_anim {
                    fl.rand()
                    break
                }
            }
        }
        if (anim.is_active(e.cur) || (pw.new_state == "instant")) {
            power_activate(p.id, e, e.pursue@0, e.pursue@1)
            loop _, q in e.powers {
                if q.id == p.id {
                    timer_set(q.cd, pw.cooldown)
                }
            }
        }
        if (anim.is_last(e.cur) && timer_end(e.state_timer)) ||
                ((pw.new_state == "attack") && (e.cur.a.name != pw.attack_anim)) || (pw.new_state == "instant") {
            if pw.new_state != "instant" {
                timer_begin(e.cooldown)
            }
            if e.hp > 0 {
                set e.state = STATE.STANCE
            }
            break [act = "stance"]
        }
        await :enemy.step
        until e.next, e.next
    }
}

;; ENTITY_SPAWN: the animation of the spawn, to its last frame
task ESpawn (e) {
    set e.state = STATE.SPAWN
    loop {
        await :enemy.step
        if e.next {
            break e.next
        }
        ai_anim(e, "spawn")
        if anim.is_last(e.cur) || (e.cur.a.name != "spawn") {
            set e.state = STATE.STANCE
            break [act = "stance"]
        }
    }
}

;; ENTITY_HIT: the animation of the hit, to its last frame
task EHit (e) {
    set e.state = STATE.HIT
    loop {
        ai_anim(e, "hit")
        if anim.is_last(e.cur) || (e.cur.a.name != "hit") {
            set e.state = STATE.STANCE
            break [act = "stance"]
        }
        await :enemy.step
        until e.next, e.next
    }
}

;; ENTITY_DEAD: the animation of death, then the corpse
;; (or ENTITY_CRITDEAD, with its animation and sounds)
task EDead (e, crit) {
    set e.state = if crit => STATE.CRITDEAD => STATE.DEAD
    val name = if crit => "critdie" => "die"
    val sfx = if crit => e.sfx_critdie => e.sfx_die
    loop {
        ai_anim(e, name)
        if anim.is_first(e.cur) && (#sfx > 0) {
            fl.rand()           ;; the sound of death
        }
        if anim.is_last(e.cur) || (e.cur.a.name != name) {
            set e.corpse = true
            fl.col_unblock(e.x, e.y)
            await(false)
        }
        await :enemy.step
    }
}

;; the action of a decision: [act = "stance" | "power", power]
func ai_act (e, next) {
    match next.act {
        "power" => EPower
        "hit" => EHit
        "dead" => EDead
        "critdead" => EDead
        "spawn" => ESpawn
        else => EStance
    }
}

task Enemy (st, me) {
    set pub = [
        name = st.name, x = fl.f32(me.x), y = fl.f32(me.y), dir = me.dir,
        hp = st.hp, hp_max = st.hp, mp = st.mp, base = st.base, speed = st.speed,
        state = if me.state == "spawn" => STATE.SPAWN => STATE.STANCE, movement = st.movement,
        melee_range = st.melee_range, threat_range = st.threat_range,
        threat_range_far = st.threat_range_far, flee_range = st.flee_range,
        chance_pursue = st.chance_pursue, chance_flee = st.chance_flee,
        combat_style = st.combat_style, facing = st.facing, turn_delay = st.turn_delay,
        sfx_attack = st.sfx_attack, sfx_hit = st.sfx_hit, sfx_die = st.sfx_die,
        sfx_critdie = st.sfx_critdie,
        corpse = false, ai_hit_power = nil, dot = 0.0, dot_percent = 0.0, loot = [], loot_count = st.loot_count, stun = false, fx_add = [], fx_remove = [],
        cooldown = timer_of(st, "cooldown", st.cooldown),
        cooldown_hit = timer_of(st, "cooldown_hit", st.cooldown_hit || 0),
        cooldown_los = timer_of(st, "cooldown_los", st.cooldown_los), state_timer = timer(0),
        waypoint_timer = timer_of(st, "waypoint_pause", st.waypoint_pause),
        flee_timer = timer_of(st, "flee_duration", st.flee_duration),
        flee_cooldown = timer_of(st, "flee_cooldown", st.flee_cooldown), turn_timer = timer(0),
        path_fail_timer = timer(60 * 2),
        powers = [],
        encountered = false, in_combat = false, join_combat = false, los = false,
        fleeing = false, move_to_safe_dist = false, collided = false,
        target_dist = 0, hero_dist = 0, pursue = [me.x, me.y], prev_target = [0, 0],
        path = [], path_found = false, path_fails = 0, chance_path = -100,
        waypoints = X.copy(me.waypoints), wander = me.wander > 0,
        wander_area = [math.floor(fl.f32(me.x)) - me.wander, math.floor(fl.f32(me.y)) - me.wander, (me.wander * 2) + 1],
        next = nil,
        anims = anim.load(st.animations),
    ]
    val e = pub
    loop _, l in st.loot {
        loot.parse(l, e.loot)
    }
    pin fx = tasks()
    loop _, p in st.powers {
        set e.powers@+ = [type = p.type, id = p.id, chance = p.chance, cd = timer(0)]
    }
    set e.cur = anim.cursor(anim.get(e.anims, ""))

    spawn {
        var next = [act = me.state || "stance"]
        loop {
            set e.next = nil
            val act = ai_act(e, next)
            set next = ifs {
                next.act == "power" => (await act(e, next.power))
                next.act == "critdead" => (await act(e, true))
                next.act == "dead" => (await act(e, false))
                else => (await act(e))
            }
        }
    }

    loop e2 on :enemy.logic {
        val hero_st = e2.hero
        ;; EntityBehavior::logic
        if e.corpse {
            ;; a corpse only waits
        } else {
          if fl.dist(e.x, e.y, hero_st.x, hero_st.y) <= ENCOUNTER_DIST {
            set e.encountered = true
          }
          if e.encountered {
            effect.logic(e, fx, task)
            ai_stats_logic(e, hero_st)
            ;; doUpkeep: a teleport of a power
            if e.teleport {
                fl.col_unblock(e.x, e.y)
                set e.x, e.y = e.teleport@0, e.teleport@1
                fl.col_block(e.x, e.y, false)
                set e.teleport = nil
            }
            if !e.stun {
                ai_find_target(e, hero_st)
                ai_check_power(e)
                ai_check_move(e, hero_st)
                ;; updateState
                anim.advance(e.cur)
                emit @(task) :enemy.step
            }
            set e.fleeing = false
          }
        }
    }
}
